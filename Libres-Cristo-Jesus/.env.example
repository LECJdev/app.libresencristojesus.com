# LCJ Connect — environment template.
#
# Copy to `.env` at the repo ROOT (never inside apps/) and adjust:
#   cp .env.example .env
#
# The defaults below match `docker-compose.yml`, so a fresh clone works
# with `docker compose up -d` and nothing else. They are DEVELOPMENT
# credentials: every secret here must be replaced before any deployment.
#
# Read by: the API (apps/api, via ConfigModule) and the Prisma CLI
# (prisma.config.ts). `apps/api/src/common/config/env.schema.ts` is the
# authority on which variables are required — a missing one aborts boot.

NODE_ENV=development
API_PORT=3001

# --- PostgreSQL (docker-compose service `postgres`) ---
DATABASE_URL=postgresql://lcj:change_me_dev_password@localhost:5432/lcj_connect

# --- Redis (docker-compose service `redis`) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Minimum 32 characters (256 bits): an HS256 signature is only as strong
# as its secret. Generate real ones with `openssl rand -base64 48`.
JWT_SECRET=dev_only_jwt_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_at_least_32_chars

# --- MinIO (docker-compose service `minio`) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=lcj_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

# --- SMTP (docker-compose service `mailpit`) ---
# Mailpit accepts unauthenticated mail, so user/password stay empty in dev.
SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
# Origin allowed through CORS and the audience the refresh-token cookie is
# scoped to from the browser's perspective.
FRONTEND_URL=http://localhost:3000

# --- Geographic catalogs ---
# Consumed ONLY by the install-time seeder (`pnpm db:seed:geo`); the
# running application never calls it.
COLOMBIA_API_URL=https://api-colombia.com/api/v1
COLOMBIA_API_TIMEOUT_MS=30000
