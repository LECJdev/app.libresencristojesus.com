{
  "name": "@lcj/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint, Prettier, and TypeScript configuration for the LCJ Connect monorepo.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
